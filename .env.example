# CBTC-LMS — Required environment variables
# Copy to .env.local and fill values. Never commit .env.local.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: Payments (Stripe)
# STRIPE_SECRET_KEY=sk_live_...

# Optional: Email (Brevo)
# BREVO_API_KEY=...

# Optional: API base URL (defaults to https://api.cobelcenter.com)
# NEXT_PUBLIC_API_URL=https://api.cobelcenter.com

# Optional: OpenAI (if using audio/assessment flows)
# OPENAI_API_KEY=sk-...

# Production
NODE_ENV=production
